{
  "expo": {
    "name": "Delhi bus crowding",
    "slug": "delhi-bus-crowding",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "android": {
      "package": "dev.hackathon.delhibuscrowding",
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#121316"
      }
    },
    "ios": {
      "bundleIdentifier": "dev.hackathon.delhibuscrowding"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "@react-native-community/datetimepicker",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Used once to find the bus stop nearest to you. Your location is not stored."
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": "http://10.0.2.2:8000"
    },
    "icon": "./assets/icon.png"
  }
}
